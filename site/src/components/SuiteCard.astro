---
import type { Suite } from "../lib/suites";
import { href } from "../lib/url";

export interface Props {
  suite: Suite;
}

const { suite } = Astro.props;
---

<a href={href(`/suites/${suite.id}/`)} class="suite-card">
  <h3 class="suite-card__title">{suite.title}</h3>
  <p class="suite-card__meta">
    {suite.questions.length} question{suite.questions.length === 1 ? "" : "s"}
  </p>
  <div class="suite-card__models">
    {suite.models.map((model) => (
      <span class="suite-card__model font-mono">
        {model.name}
        {model.effort ? `:${model.effort}` : ""}
      </span>
    ))}
  </div>
</a>

<style>
  .suite-card {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    background: var(--surface-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: inherit;
    transition:
      transform 150ms,
      box-shadow 150ms,
      border-color 150ms;
  }

  .suite-card:hover,
  .suite-card:focus-visible {
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-raised);
    border-color: var(--accent);
  }

  .suite-card__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 0.375rem;
  }

  .suite-card__meta {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }

  .suite-card__models {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .suite-card__model {
    font-size: 0.75rem;
    padding: 0.1875rem 0.5rem;
    border-radius: 9999px;
    background: var(--accent-soft);
    color: var(--accent);
  }
</style>
