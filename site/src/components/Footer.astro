---
const repoUrl = "https://github.com/gordonwatts/iris-hep-llm-performance";
const runnerUrl = "https://github.com/gordonwatts/test-wsl2-llm";
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>
      Suite specs live in <a href={repoUrl}>iris-hep-llm-performance</a>; runs
      execute via <a href={runnerUrl}>test-wsl2-llm</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    margin-top: 3rem;
  }

  .site-footer__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .site-footer p {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .site-footer a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .site-footer a:hover,
  .site-footer a:focus-visible {
    color: var(--accent);
  }
</style>
