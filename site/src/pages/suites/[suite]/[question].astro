---
import Layout from "../../../layouts/Layout.astro";
import EmptyResultsPanel from "../../../components/EmptyResultsPanel.astro";
import { extractDatasets } from "../../../lib/datasets";
import { renderPrompt } from "../../../lib/prompt";
import { loadSuites, type Question, type Suite } from "../../../lib/suites";
import { href } from "../../../lib/url";

export function getStaticPaths() {
  return loadSuites().flatMap((suite) =>
    suite.questions.map((question) => ({
      params: { suite: suite.id, question: question.id },
      props: { suite, question },
    })),
  );
}

interface Props {
  suite: Suite;
  question: Question;
}

const { suite, question } = Astro.props;

const renderedPrompt = renderPrompt(suite.promptTemplate, {
  question: question.question,
  ...question.extras,
});
const datasets = extractDatasets(question.question);

const effectiveDistro = question.distro ?? suite.distro;
const effectiveCopyBack = question.copyBack ?? suite.copyBack;
const effectivePlugins = question.plugins ?? suite.plugins;
---

<Layout title={`${question.id} · ${suite.title}`}>
  <section class="question">
    <p class="question__breadcrumb">
      <a href={href(`/suites/${suite.id}/`)}>{suite.title}</a> /{" "}
      <span class="font-mono">{question.id}</span>
    </p>

    <h1 class="question__title font-mono">{question.id}</h1>
    <p class="question__text">{question.question}</p>

    {datasets.length > 0 && (
      <div class="question__datasets">
        {datasets.map((dataset) => (
          <span class="question__dataset font-mono">{dataset}</span>
        ))}
      </div>
    )}

    <div class="question__prompt">
      <div class="question__prompt-header">
        <h2 class="question__section-heading">Effective prompt</h2>
        <button
          type="button"
          class="question__copy-button"
          data-copy-target="effective-prompt"
        >
          Copy
        </button>
      </div>
      <pre
        id="effective-prompt"
        class="question__prompt-body font-mono"
      ><code>{renderedPrompt}</code></pre>
    </div>

    <dl class="question__config">
      <div>
        <dt>Distro</dt>
        <dd class="font-mono">
          {effectiveDistro ?? "—"}
          {question.distro && (
            <span class="question__override-tag">override</span>
          )}
        </dd>
      </div>
      <div>
        <dt>Plugins</dt>
        <dd class="font-mono">
          {effectivePlugins.length ? effectivePlugins.join(", ") : "—"}
          {question.plugins && (
            <span class="question__override-tag">override</span>
          )}
        </dd>
      </div>
      <div>
        <dt>Copy back</dt>
        <dd class="font-mono">
          {effectiveCopyBack.length ? effectiveCopyBack.join(", ") : "—"}
          {question.copyBack && (
            <span class="question__override-tag">override</span>
          )}
        </dd>
      </div>
    </dl>
  </section>

  <section class="question__results">
    <h2 class="question__section-heading">Results</h2>
    <EmptyResultsPanel scope={`question "${question.id}"`} />
  </section>
</Layout>

<style>
  .question,
  .question__results {
    max-width: 56rem;
    margin: 0 auto;
    padding: 1.5rem;
  }

  .question {
    padding-top: 2.5rem;
  }

  .question__breadcrumb {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin: 0 0 0.75rem;
  }

  .question__breadcrumb a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .question__breadcrumb a:hover,
  .question__breadcrumb a:focus-visible {
    color: var(--accent);
  }

  .question__title {
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.75rem;
  }

  .question__text {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0 0 1rem;
    white-space: pre-wrap;
  }

  .question__datasets {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin: 0 0 1.5rem;
  }

  .question__dataset {
    font-size: 0.6875rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    color: var(--text-primary);
    word-break: break-all;
  }

  .question__prompt {
    margin: 0 0 1.5rem;
  }

  .question__prompt-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .question__section-heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  .question__copy-button {
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: 0.375rem;
    border: 1px solid var(--border-subtle);
    background: var(--surface-card);
    color: var(--text-primary);
    cursor: pointer;
    transition: border-color 150ms;
  }

  .question__copy-button:hover,
  .question__copy-button:focus-visible {
    border-color: var(--accent);
  }

  .question__prompt-body {
    padding: 1rem;
    background: var(--surface-sunken);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-card);
    font-size: 0.8125rem;
    white-space: pre-wrap;
    overflow-x: auto;
  }

  .question__config {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 1rem 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--border-subtle);
  }

  .question__config dt {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 0.25rem;
  }

  .question__config dd {
    font-size: 0.8125rem;
    color: var(--text-primary);
    margin: 0;
  }

  .question__override-tag {
    display: inline-block;
    margin-left: 0.375rem;
    font-size: 0.625rem;
    font-family: var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent);
    background: var(--accent-soft);
    border-radius: 0.25rem;
    padding: 0.0625rem 0.375rem;
  }
</style>

<script>
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-target]")
    .forEach((button) => {
      button.addEventListener("click", async () => {
        const targetId = button.dataset.copyTarget;
        const target = targetId ? document.getElementById(targetId) : null;
        if (!target) return;

        try {
          await navigator.clipboard.writeText(target.textContent ?? "");
          const original = button.textContent;
          button.textContent = "Copied";
          setTimeout(() => {
            button.textContent = original;
          }, 1500);
        } catch {
          // Clipboard access can be denied by the browser; the prompt text is
          // still fully visible and selectable, so this is a soft failure.
        }
      });
    });
</script>
